{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "GRPO",
            "type": "debugpy",
            "request": "launch",
            // "program": "${file}",
            "module": "torch.distributed.run",
            "cwd": "${workspaceFolder}/src/r1-v",
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                // "PYTHONPATH": "${workspaceFolder}/src/r1-v/src:${env:PYTHONPATH}",
                "DEBUG_MODE": "true",
                "LOG_PATH": "/mnt/task_runtime/outs/debug_log_2b.txt",
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "args": [
                "--nproc_per_node=1",
                "--nnodes=1",
                "--node_rank=0",
                "--master_addr=127.0.0.1",
                "--master_port=12345",
                "src/open_r1/grpo.py",
                "--output_dir",
                "/mnt/task_runtime/outs/",
                "--model_name_or_path",
                "/mnt/task_runtime/ckpts/Qwen2-VL-2B-Instruct",
                "--dataset_name",
                "/mnt/task_runtime/dses/clevr_cogen_a_train",
                "--deepspeed",
                "local_scripts/zero3.json",
                "--max_prompt_length",
                "512",
                "--max_completion_length",
                "512",
                "--per_device_train_batch_size",
                "1",
                "--gradient_accumulation_steps",
                "2",
                "--logging_steps",
                "1",
                "--bf16",
                "--gradient_checkpointing",
                "false",
                "--attn_implementation",
                "sdpa",
                "--max_pixels",
                "401408",
                "--num_train_epochs",
                "2",
                "--run_name",
                "Qwen2-VL-2B-GRPO-CLEVR-70k",
                "--save_steps",
                "100",
                "--save_only_model",
                "true",
                "--num_generations",
                "8",
                "--train_last_n_layers",
                "1",
                "--train_lm_head"
            ]
        }
    ]
}